{
  "$id": "https://qtsgroup.vn/identity/schema/qts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QTS Identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string", "format": "email", "title": "Email công việc",
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true }, "totp": { "account_name": true } },
            "verification": { "via": "email" }, "recovery": { "via": "email" }
          }
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160, "title": "Họ và tên" }
      },
      "required": ["email", "name"],
      "additionalProperties": false
    }
  }
}
