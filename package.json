{
  "name": "qts-enterprise-ecosystem",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "frontend-client",
    "frontend-portal/portal",
    "frontend-portal/identity",
    "frontend-hrm",
    "packages/app-chrome",
    "packages/oidc-client"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@qts/web",
    "dev:portal": "npm run dev --workspace=@qts/portal",
    "dev:identity": "npm run dev --workspace=@qts/identity",
    "dev:hrm": "npm run dev --workspace=@qts/hrm",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@qts/web",
    "build:identity": "npm run build --workspace=@qts/identity",
    "build:portal": "npm run build --workspace=@qts/portal",
    "build:hrm": "npm run build --workspace=@qts/hrm",
    "build:parallel": "npm-run-all --parallel build:web build:identity build:portal build:hrm",
    "lint": "npm run lint --workspaces --if-present",
    "audit:security": "node scripts/audit-security.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ory": "playwright test --config=playwright.ory.config.ts",
    "test:landing": "playwright test --config=playwright.landing.config.ts",
    "test:portal": "playwright test --config=playwright.portal.config.ts",
    "test:hrm": "playwright test --config=playwright.hrm.config.ts",
    "test:production": "playwright test --config=playwright.production.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "1.63.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.41.0"
  },
  "overrides": {
    "typescript": "~5.9.2",
    "postcss": "^8.5.28"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
