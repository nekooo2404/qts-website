{
  "name": "qts-enterprise-ecosystem",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "workspaces": ["apps/web", "apps/portal", "apps/identity"],
  "scripts": {
    "dev:web": "npm run dev --workspace=@qts/web",
    "dev:portal": "npm run dev --workspace=@qts/portal",
    "dev:identity": "npm run dev --workspace=@qts/identity",

    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@qts/web",
    "build:identity": "npm run build --workspace=@qts/identity",
    "build:portal": "npm run build --workspace=@qts/portal",
    "build:parallel": "npm-run-all --parallel build:web build:identity build:portal",

    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },

  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },

  "overrides": {
    "typescript": "~5.9.2"
  },

  "engines": {
    "node": ">=20.9.0",
    "npm": ">=12.0.0"
  }
}
