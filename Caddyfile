# QTS reverse proxy (Caddy) — production domains qts.vn
# Caddy auto-issues Let's Encrypt certs on port 443.
# Compose ports stay localhost-only in production; edit docker-compose.yml
# port bindings to "127.0.0.1:<port>:<port>" before going live.

# Marketing site (Next.js web app)
qts.vn {
	reverse_proxy localhost:3000
	header {
		# Security headers cho production
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	encode zstd gzip
}

# Portal (Vite SPA)
portal.qts.vn {
	reverse_proxy localhost:5174
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
	encode zstd gzip
}

# Identity Center (Next.js identity app)
identity.qts.vn {
	reverse_proxy localhost:3001
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
	encode zstd gzip
}

# Django REST API
api.qts.vn {
	reverse_proxy localhost:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	encode zstd gzip
}

# Keycloak SSO (admin console + token endpoints)
sso.qts.vn {
	reverse_proxy localhost:8081
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}