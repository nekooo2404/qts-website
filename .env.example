# Copy to .env, then run scripts/configure-ory-env.sh .env.
COMPOSE_PROJECT_NAME=qtsss
POSTGRES_DB=qts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5174,http://localhost:5175
IDENTITY_PROVIDER=ory
IDENTITY_ISSUER=http://localhost:8084
IDENTITY_WEB_ORIGIN=http://localhost:3001
IDENTITY_PRIMARY_DOMAIN=qts.com
IDENTITY_REQUIRE_MFA=false
IDENTITY_SIGNING_KEY_PASSPHRASE=replace-with-random-secret
SEED_DEMO_USERS=false
# Local/dev may keep a Git-ignored bootstrap secret file for repeatable testing.
# Production must inject BOOTSTRAP_SUPERADMIN_PASSWORD or mount a secret-manager file outside .secrets.
# BOOTSTRAP_SUPERADMIN_REQUIRES_ENROLLMENT=true
# BOOTSTRAP_SUPERADMIN_PASSWORD_FILE=/run/secrets/qts_bootstrap_superadmin_password
ORY_HYDRA_ISSUER_BROWSER_URL=http://localhost:4444/
ORY_KRATOS_BROWSER_URL=http://localhost:3001/kratos
ORY_HYDRA_ADMIN_URL=http://hydra:4445
ORY_KRATOS_INTERNAL_PUBLIC_URL=http://kratos:4433
ORY_KRATOS_ADMIN_URL=http://kratos:4434
ORY_HYDRA_CLIENT_ID_PORTAL=qts-portal
ORY_HYDRA_CLIENT_ID_HRM=qts-hrm
ORY_HYDRA_LOGIN_URL=http://localhost:3001/identity-api/oauth/ory/login
ORY_HYDRA_CONSENT_URL=http://localhost:3001/identity-api/oauth/ory/consent
ORY_HYDRA_LOGOUT_URL=http://localhost:3001/identity-api/oauth/ory/logout
ORY_API_AUDIENCE=qts-api
ORY_JIT_PROVISIONING=false
ORY_JIT_ALLOWED_DOMAINS=qts.com
# Configure-ory-env generates these secrets/DSNs without printing values.
ORY_HYDRA_DB_PASSWORD=
ORY_KRATOS_DB_PASSWORD=
ORY_HYDRA_DSN=
ORY_KRATOS_DSN=
ORY_HYDRA_SYSTEM_SECRET=
ORY_KRATOS_COOKIE_SECRET=
ORY_KRATOS_CIPHER_SECRET=
# Local mail catcher only. Production email flows stay disabled until real SMTP exists.
ORY_EMAIL_FLOWS_ENABLED=false
ORY_SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true
VITE_IDENTITY_ISSUER=http://localhost:4444/
VITE_API_ISSUER=http://localhost:8084
VITE_IDENTITY_WEB_ORIGIN=http://localhost:3001
VITE_PORTAL_OIDC_CLIENT_ID=qts-portal
VITE_PORTAL_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
VITE_PORTAL_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/
VITE_HRM_OIDC_CLIENT_ID=qts-hrm
VITE_ALLOW_INSECURE_LOCAL_OIDC=true
VITE_HRM_OIDC_REDIRECT_URI=http://localhost:5175/auth/callback
VITE_HRM_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5175/
REDIS_URL=redis://redis:6379/1
NEXT_PUBLIC_SITE_URL=https://qtsgroup.vn
IDENTITY_API_ORIGIN=http://localhost:8084
IDENTITY_BRIDGE_ORIGIN=http://localhost:8085
LEAD_NOTIFY_EMAIL=
LEAD_POW_PREFIX=000
LEAD_CONSULTATION_RATE=60/min
LEAD_CONSULTATION_EMAIL_RATE=20/hour
QTS_EVENT_STREAM_URL=redis://redis:6379/3
QTS_SECURITY_ENABLED=true
QTS_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5174,http://localhost:5175
QTS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
QTS_IDENTITY_ISSUER=http://localhost:4444/
QTS_IDENTITY_JWK_SET_URI=http://hydra:4444/.well-known/jwks.json
QTS_IDENTITY_AUDIENCE=qts-api
QTS_IDENTITY_BRIDGE_ENABLED=false
ORY_KRATOS_SESSION_COOKIE=ory_kratos_session
LEAD_FLYWAY_ENABLED=true
EVENT_FLYWAY_ENABLED=true
ATTENDANCE_FLYWAY_ENABLED=true
HRM_FLYWAY_ENABLED=true
HRM_MAX_PAGE_SIZE=100
QTS_SPRING_CANARIES_ENABLED=false
QTS_EVENT_POLL_ENABLED=false
QTS_EVENT_MAIL_ENABLED=false
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
# Operational limits for attendance device sync (ADR-PROTO-010), not a public quota catalog.
ATTENDANCE_SYNC_DEVICE_THROTTLE=120/min
ATTENDANCE_SYNC_TENANT_THROTTLE=1200/min
