# Public marketing site
NEXT_PUBLIC_API_URL=http://localhost:8000

# QTS Identity Center frontend proxy
IDENTITY_API_ORIGIN=http://localhost:8000

# Django API - PostgreSQL is required
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5174
POSTGRES_DB=qts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Buiduchoa2404
POSTGRES_HOST=db
POSTGRES_PORT=5433

# QTS Identity protocol and runtime. Use a unique secret and KMS-backed encryption material in production.
IDENTITY_ISSUER=http://localhost:8000
IDENTITY_WEB_ORIGIN=http://localhost:3001
IDENTITY_SIGNING_KEY_PASSPHRASE=development-only-key-encryption-secret
IDENTITY_TOKEN_LIFETIME_SECONDS=900
IDENTITY_CODE_LIFETIME_SECONDS=120
IDENTITY_REFRESH_LIFETIME_DAYS=7
REDIS_URL=redis://localhost:6379/1

# Identity provider. Keep local for Django OIDC; switch to keycloak for Keycloak OIDC.
IDENTITY_PROVIDER=local
KEYCLOAK_ISSUER=http://localhost:8081/realms/qts
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/qts
KEYCLOAK_AUDIENCE=account
KEYCLOAK_JWKS_CACHE_SECONDS=900

# Keycloak development admin. Never use these credentials in production.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-local

# Portal public OIDC client. VITE_* values ship to browser: never add a client secret.
# VITE_IDENTITY_ISSUER is the OIDC provider; VITE_API_ISSUER is Django's entitlement API.
VITE_IDENTITY_ISSUER=http://localhost:8081/realms/qts
VITE_API_ISSUER=http://localhost:8000
VITE_PORTAL_OIDC_CLIENT_ID=qts-portal
VITE_PORTAL_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
VITE_PORTAL_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/
